{{page-title "Songs to Practice"}}

{{#in-element (get-header-links)}}
    {{#if this.isUserMe}}
        <EuiSelect
            @value={{this.drumTabSource}}
            @options={{this.drumTabSources}}
            {{on "change" this.updateDrumTabSource}}
        />
    {{/if}}
{{/in-element}}

<EuiText @grow={{false}}>
    <h2>Practice ({{@model.songs.length}})</h2>
</EuiText>

<EuiSpacer @size="l" />

<EuiFlexGrid @columns={{3}} @responsive={{true}}>
    {{#each @model.songs as |song|}}
        <EuiFlexItem>
            <Song
                @user={{@model.user}}
                @song={{song}}
                @songEditing={{this.cacheScrollPosition}}
                @tabSource={{this.drumTabSource}}
            />
        </EuiFlexItem>
    {{/each}}
    <div {{this.scrollToSong}} />
</EuiFlexGrid>