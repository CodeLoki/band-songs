{{page-title "Other"}}

<EuiText>
    <h2>Other Songs ({{@model.songs.length}})</h2>
</EuiText>
<EuiSpacer @size="m" />

<EuiFlexGrid @columns={{3}} @responsive={{true}}>
    {{#each @model.songs as |song|}}
        <EuiFlexItem>
            <Song
                @user={{@model.user}}
                @song={{song}}
                @cacheScroll={{this.cacheScrollPosition}}
                @mode={{this.editMode}}
            />
        </EuiFlexItem>
    {{/each}}
    <div {{this.scrollToSong}} />
</EuiFlexGrid>