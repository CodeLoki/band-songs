{{page-title "Edit"}}

{{#in-element (get-header-links)}}
    {{#if (can-user-edit)}}
        <EuiHeaderLink @iconType="save" {{on "click" this.save}}>
            Save
        </EuiHeaderLink>
        {{#if @model}}
            <EuiHeaderLink
                @iconType="eraser"
                {{on "click" this.toggleDeleteModal}}
            >
                Delete
            </EuiHeaderLink>
        {{/if}}
        <EuiHeaderLink @iconType="cross" {{on "click" this.goBack}}>
            Cancel
        </EuiHeaderLink>
    {{/if}}
{{/in-element}}

<EuiForm>
    <EuiFlexGroup @direction="row" @gutterSize="l">

        <EuiFlexItem>
            <EuiFlexGroup @direction="column" @gutterSize="s">
                <EuiFlexItem>
                    <FormControl @label="Title" as |id|>
                        <EuiFieldText
                            @value={{this.title}}
                            id={{id}}
                            @fullWidth={{true}}
                            {{on "change" (fn this.updateStringValue "title")}}
                        />
                    </FormControl>
                </EuiFlexItem>

                <EuiFlexItem>
                    <FormControl @label="Artist" as |id|>
                        <EuiFieldText
                            @value={{this.artist}}
                            id={{id}}
                            @fullWidth={{true}}
                            {{on "change" (fn this.updateStringValue "artist")}}
                        />
                    </FormControl>
                </EuiFlexItem>

                <EuiFlexItem>
                    <FormControl @label="Length" as |id|>
                        <EuiFieldNumber
                            @value={{this.length}}
                            id={{id}}
                            @fullWidth={{true}}
                            {{on "change" (fn this.updateNumberValue "length")}}
                        />
                    </FormControl>
                </EuiFlexItem>

                <EuiFlexItem>
                    <FormControl @label="Starts With" as |id|>
                        <EuiSelect
                            @value={{this.startsWith}}
                            @options={{this.startsWithOptions}}
                            @fullWidth={{true}}
                            id={{id}}
                            {{on "change" this.updateStartsWith}}
                        />
                    </FormControl>
                </EuiFlexItem>

                <EuiFlexItem>
                    <FormControl @label="Features" as |id|>
                        <EuiSelect
                            @value={{this.features}}
                            @options={{this.featuresOptions}}
                            @fullWidth={{true}}
                            id={{id}}
                            {{on "change" this.updateFeatures}}
                        />
                    </FormControl>
                </EuiFlexItem>

                <EuiFlexItem>
                    <FormControl @label="Solos" class="auto-height" as |id|>
                        <InstrumentSelector
                            @selectedInstruments={{this.solos}}
                            @changeSelection={{this.updateSolos}}
                            id={{id}}
                        />
                    </FormControl>
                </EuiFlexItem>

                <EuiFlexItem>
                    <FormControl
                        @label="GrooveScribe"
                        class="auto-height"
                        as |id|
                    >
                        <EuiTextArea
                            @value={{this.groove}}
                            @fullWidth={{true}}
                            rows={{5}}
                            id={{id}}
                            {{on "change" (fn this.updateStringValue "groove")}}
                        />
                    </FormControl>
                </EuiFlexItem>

                <EuiFlexItem>
                    <FormControl @label="YT Music" as |id|>
                        <EuiFieldText
                            @value={{this.ytMusic}}
                            id={{id}}
                            @fullWidth={{true}}
                            {{on
                                "change"
                                (fn this.updateStringValue "ytMusic")
                            }}
                        />
                    </FormControl>
                </EuiFlexItem>

                <EuiFlexItem>
                    <FormControl @label="Drum Notes" as |id|>
                        <EuiFieldText
                            @value={{this.notes}}
                            id={{id}}
                            @fullWidth={{true}}
                            {{on "change" (fn this.updateStringValue "notes")}}
                        />
                    </FormControl>
                </EuiFlexItem>

                <EuiFlexItem>
                    <FormControl @label="Percussion Pad" as |id|>
                        <EuiSelect
                            @value={{this.pad}}
                            @fullWidth={{true}}
                            @options={{this.padOptions}}
                            id={{id}}
                            {{on "change" this.updatePad}}
                        />
                    </FormControl>
                </EuiFlexItem>

                <EuiFlexItem>
                    <FormControl @label="Bands" class="auto-height" as |id|>
                        <EuiCheckboxGroup
                            @options={{this.bandOptions}}
                            @idToSelectedMap={{this.selectedBands}}
                            @valueKey="value"
                            @onChange={{this.selectBands}}
                            id={{id}}
                        />
                    </FormControl>
                </EuiFlexItem>

                <EuiFlexItem>
                    <EuiFormControlLayout>
                        <:field>
                            <EuiCheckbox
                                @label="Flag for practice"
                                @checked={{this.practice}}
                                {{on "change" this.flagForPractice}}
                            />
                        </:field>
                    </EuiFormControlLayout>
                </EuiFlexItem>

            </EuiFlexGroup>
        </EuiFlexItem>
    </EuiFlexGroup>
</EuiForm>

{{#if this.showDeleteModal}}
    <DeleteModal
        @title={{this.title}}
        @toggleDeleteModal={{this.toggleDeleteModal}}
        @delete={{this.delete}}
    />
{{/if}}