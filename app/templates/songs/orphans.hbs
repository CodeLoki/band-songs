{{page-title "Orphaned Songs"}}

<EuiText @grow={{false}}>
    <h2>Orphaned Songs ({{@model.songs.length}})</h2>
</EuiText>

<EuiSpacer @size="l" />

<EuiFlexGrid @columns={{3}} @responsive={{true}}>
    {{#each @model.songs as |song|}}
        <EuiFlexItem>
            <Song
                @user={{@model.user}}
                @song={{song}}
                @songEditing={{this.cacheScrollPosition}}
            />
        </EuiFlexItem>
    {{/each}}
    <div {{this.scrollToSong}} />
</EuiFlexGrid>