<EuiText @grow={{false}}>
    <h2>Gigs</h2>
</EuiText>

<EuiSpacer @size="l" />

<EuiFlexGrid @columns={{3}} @responsive={{true}}>
    {{#each @model as |gig|}}
        <EuiFlexItem>
            <GigCard @gig={{gig}} />
        </EuiFlexItem>
    {{else}}
        <EuiPanel @color="subdued" @borderRadius="none" @hasShadow={{false}}>
            <p>No gigs yet.</p>
        </EuiPanel>
    {{/each}}
</EuiFlexGrid>

{{#in-element (get-header-links)}}
    {{#if (can-user-edit)}}
        <EuiHeaderLink
            @iconType="createAdvancedJob"
            {{on "click" (go-to "gig.edit" "new")}}
        >
            Add
        </EuiHeaderLink>
    {{/if}}
{{/in-element}}